# ─── Telegram bot: the chat where digests arrive ───
BOT_TOKEN=123456:your-bot-token           # @BotFather -> /newbot
OWNER_ID=123456789                        # your numeric user id (@userinfobot); nobody else can use the bot

# ─── Your Telegram account: used only to READ the channels you follow ───
TG_API_ID=1234567                         # https://my.telegram.org -> API development tools
TG_API_HASH=your-api-hash
# TG_SESSION=data/owner                   # session file path; full access to your account, never share it

# ─── Model: any OpenAI-compatible API ───
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-5.6-luna
# LLM_BASE_URL=https://api.openai.com/v1  # OpenRouter: https://openrouter.ai/api/v1 (then LLM_MODEL=qwen/qwen3.8-flash etc.)
# VISION_MODEL=                           # model for image captions; defaults to LLM_MODEL, must accept images

# ─── Digest ───
# Time, timezone and language are only starting values: change them any time in /settings
# DIGEST_TIME=09:00
# TIMEZONE=Europe/Moscow
# DIGEST_LANGUAGE=ru                      # ru | en | es | fr | kk - language the summaries are written in
# UI_LANGUAGE=ru                          # ru | en - bot commands and messages
# DESCRIBE_IMAGES=true
# MAX_IMAGES_PER_RUN=20                   # cost cap for image captions per digest
# LOOKBACK_HOURS=24                       # how far back the first digest of a new channel looks
# MAX_POSTS_PER_CHANNEL=60
# LOG_LEVEL=INFO
